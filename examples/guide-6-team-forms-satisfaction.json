    {
      "id": "9fb3594e-46fd-4ba7-a628-1da6cb00df2e",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -600,
        -300
      ],
      "parameters": {
        "content": "## Ghamalim guide 6: Team, saved replies, forms, satisfaction\nClick **Execute workflow**: everything that is switched on only reads.\n\nThe one grey step creates a label. Activate it (select it, press **D**) only when you mean it.",
        "width": 560,
        "height": 240,
        "color": 4
      }
    },
    {
      "id": "8c49a78a-819d-4f19-9623-aedbafe65ebb",
      "name": "Note 2",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        -60
      ],
      "parameters": {
        "content": "### 1. Groups\nYour teams. Use a group's ID as **Assigned Group** in Ticket: Update, or as a filter in Ticket: Get Many.",
        "width": 300,
        "height": 220,
        "color": 7
      }
    },
    {
      "id": "9ca50648-403a-4631-b680-4564c9c8b45a",
      "name": "List groups",
      "type": "n8n-nodes-ghamalim.ghamalim",
      "typeVersion": 1,
      "position": [
        120,
        0
      ],
      "parameters": {
        "resource": "group",
        "operation": "getAll",
        "returnAll": false,
        "limit": 20
      }
    },
    {
      "id": "ffb71a14-cc23-46a3-93c3-650820548443",
      "name": "Note 3",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        200
      ],
      "parameters": {
        "content": "### 2. Saved replies\nThe ready-made texts your team shares. Find one by keyword and put its `body` into **Message: Send**. Private replies of a member are never listed.",
        "width": 300,
        "height": 220,
        "color": 7
      }
    },
    {
      "id": "93eb3d20-4a37-41d7-8c27-95b487ba65ad",
      "name": "Find a saved reply",
      "type": "n8n-nodes-ghamalim.ghamalim",
      "typeVersion": 1,
      "position": [
        120,
        260
      ],
      "parameters": {
        "resource": "savedReply",
        "operation": "getAll",
        "returnAll": false,
        "limit": 5,
        "filters": {
          "search": "refund"
        }
      }
    },
    {
      "id": "7f16c35d-e333-49a3-8006-3a9d4cbed97e",
      "name": "Note 4",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        460
      ],
      "parameters": {
        "content": "### 3. Forms and their answers\n**Get Many** lists your forms with their questions. **Get Responses** returns what customers answered, newest first, one item per response with the answers by question.",
        "width": 300,
        "height": 220,
        "color": 7
      }
    },
    {
      "id": "592fdfc9-1412-4df6-b432-155f1aa24304",
      "name": "List forms",
      "type": "n8n-nodes-ghamalim.ghamalim",
      "typeVersion": 1,
      "position": [
        120,
        520
      ],
      "parameters": {
        "resource": "form",
        "operation": "getAll",
        "returnAll": false,
        "limit": 20
      }
    },
    {
      "id": "f6a04511-2475-49b2-8cda-22c24801578a",
      "name": "First form",
      "type": "n8n-nodes-base.limit",
      "typeVersion": 1,
      "position": [
        360,
        520
      ],
      "parameters": {
        "maxItems": 1
      }
    },
    {
      "id": "bfe6a638-bb0f-43bf-848e-38343b441c94",
      "name": "Get its responses",
      "type": "n8n-nodes-ghamalim.ghamalim",
      "typeVersion": 1,
      "position": [
        600,
        520
      ],
      "parameters": {
        "resource": "form",
        "operation": "getResponses",
        "formId": "={{ $json.id }}",
        "returnAll": false,
        "limit": 10,
        "responseState": "answered"
      }
    },
    {
      "id": "b855505a-ed65-4ceb-96f8-8a10f5bd1d18",
      "name": "Note 5",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        720
      ],
      "parameters": {
        "content": "### 4. Satisfaction ratings\nThe 1 to 5 score and comment a customer gave after a conversation was resolved. Filter by score to find unhappy customers, or by date for a weekly report.",
        "width": 300,
        "height": 220,
        "color": 7
      }
    },
    {
      "id": "897ded96-abd8-4a30-b6fa-0e6247035bd9",
      "name": "Ratings of the last week",
      "type": "n8n-nodes-ghamalim.ghamalim",
      "typeVersion": 1,
      "position": [
        120,
        780
      ],
      "parameters": {
        "resource": "satisfaction",
        "operation": "getAll",
        "returnAll": false,
        "limit": 50,
        "filters": {
          "createdAfter": "={{ $now.minus({ days: 7 }).toISO() }}"
        }
      }
    },
    {
      "id": "adf8f415-3d72-4833-9732-101f6a150051",
      "name": "Lowest ratings",
      "type": "n8n-nodes-ghamalim.ghamalim",
      "typeVersion": 1,
      "position": [
        360,
        780
      ],
      "parameters": {
        "resource": "satisfaction",
        "operation": "getAll",
        "returnAll": false,
        "limit": 10,
        "filters": {
          "score": 1
        }
      }
    },
    {
      "id": "e667fe96-f374-4017-b678-1a794114ecd2",
      "name": "Note 6",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        980
      ],
      "parameters": {
        "content": "### 5. Search contacts\n**Search** finds contacts by part of the name, email or phone. For an exact lookup from your own system use the Phone, Email or External ID filter instead (guide 2).",

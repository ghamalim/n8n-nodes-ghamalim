{
  "name": "Ghamalim guide 7 - Trigger: forms, notes, tags, priority",
  "nodes": [
    {
      "id": "0181f05e-1b8c-4bf1-bd1f-ab39d50607a0",
      "name": "Note 1",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -600,
        -300
      ],
      "parameters": {
        "content": "## Ghamalim guide 7: Trigger for forms, notes, tags and priority\nThis workflow is **off**. Turning it on registers a webhook in Ghamalim for the four events ticked in the trigger, and turning it off removes it.\n\nEvery step here only reads. Add your own steps after each branch.",
        "width": 560,
        "height": 240,
        "color": 4
      }
    },
    {
      "id": "0ce80fc3-3849-4e46-b908-dc96ba5bb92d",
      "name": "Ghamalim Trigger",
      "type": "n8n-nodes-ghamalim.ghamalimTrigger",
      "typeVersion": 1,
      "position": [
        -520,
        300
      ],
      "parameters": {
        "events": [
          "form.submitted",
          "note.created",
          "tag.removed",
          "ticket.priority_changed"
        ]
      }
    },
    {
      "id": "c2c1d210-be1a-4bf3-b208-4bfdad11a9e7",

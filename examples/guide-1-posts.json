    },
    {
      "id": "16fd9901-46c1-45ff-b697-928dcc4d1ce4",
      "name": "Note 30",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        2380
      ],
      "parameters": {
        "content": "### 10. Write captions with AI\nReturns one caption per platform from a short brief. Nothing is posted: use the text you like as the Caption of a Create step, e.g. `{{ $json.caption }}`. Counts as one AI session of your plan.",
        "width": 300,
        "height": 220,
        "color": 7
      }
    },
    {
      "id": "1fabbb11-c0d6-4e11-9795-5f07d6a45173",
      "name": "Generate captions",
      "type": "n8n-nodes-ghamalim.ghamalim",
      "typeVersion": 1,
      "position": [
        120,
        2440
      ],
      "parameters": {
        "resource": "post",
        "operation": "generateCaptions",
        "brief": "New 2-bedroom condo near BTS Thong Lo, fully furnished, 35,000 THB per month. Friendly invitation to book a viewing.",
        "captionOptions": {
          "platforms": [
            "facebook",
            "instagram"
          ],
          "tone": "friendly"
        }
      },
      "disabled": true,
      "notes": "Uses one AI session of your plan.",
      "notesInFlow": true
    },
    {
      "id": "76af57ab-4518-4b96-bf92-f2fcfe34fd1c",
      "name": "Note 32",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -240,
        2640
      ],
      "parameters": {
        "content": "### 11. Post a file that is not online yet\nMedia must be a public https link. For a file that only exists inside the workflow, **Media > Upload** stores it and returns a link; pass that link to the post as `{{ $json.url }}`.",
        "width": 300,
        "height": 220,
        "color": 7
      }
    },
